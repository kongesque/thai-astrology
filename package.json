{
  "name": "thai-astrology",
  "version": "0.3.0",
  "description": "Open-source Thai astrology (โหราศาสตร์ไทย) library for JavaScript and TypeScript. Calculate Suriyayatra natal charts, ascendants, planetary positions and transits, with Taksa and the Thai lunar calendar.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongesque/thai-astrology.git"
  },
  "homepage": "https://github.com/kongesque/thai-astrology#readme",
  "bugs": {
    "url": "https://github.com/kongesque/thai-astrology/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README-en.md",
    "SOURCES.md",
    "assets/rasi-chart.svg"
  ],
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "docs:chart": "npm run build && node scripts/render-readme-chart.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.cjs",
    "test:package": "node scripts/test-package.cjs",
    "test:local": "npm run build && node scripts/local-validation.cjs",
    "check": "npm run typecheck && npm test && npm run test:local && npm run test:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "thai",
    "thai-astrology",
    "thai-horoscope",
    "โหราศาสตร์ไทย",
    "สุริยยาตร์",
    "ผูกดวง",
    "ลัคนา",
    "astrology",
    "horoscope",
    "suriyayatra",
    "natal-chart",
    "birth-chart",
    "ascendant",
    "planetary-transits",
    "ephemeris",
    "lunar",
    "thai-lunar-calendar",
    "taksa",
    "javascript",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=16"
  }
}
